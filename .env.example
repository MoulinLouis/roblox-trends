# Leave DATABASE_URL empty to use the local PostgreSQL-compatible PGlite database.
DATABASE_URL=
PGLITE_DATA_DIR=.data/roblox-trends

# Optional single-user Basic Authentication for the web interface.
APP_USERNAME=radar
APP_PASSWORD=

# Collection defaults. Settings changed in the UI take precedence.
ROBLOX_COUNTRY=all
ROBLOX_DEVICE=computer
ROLIMONS_ENABLED=true

# Optional AI-assisted idea generation. Deterministic generation works without these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional daily Discord report target. It can also be stored from Settings.
DISCORD_WEBHOOK_URL=

# v2 PostgreSQL 18 + TimescaleDB database (required).
DATABASE_URL=

# Disposable PostgreSQL 18 + TimescaleDB server for *.db.test.ts suites; its user must be able to create databases.
# Set it in .env.test.local: Vitest runs with NODE_ENV=test, and @next/env does not read .env.local in that mode.
# CI provides one, and a missing value fails the run there. Never put LEGACY_DATABASE_URL here.
TEST_DATABASE_URL=

# v1 Aiven PRODUCTION database. Only `npm run import:legacy` reads it, in read-only transactions.
# Never use it as DATABASE_URL.
LEGACY_DATABASE_URL=

# Healthchecks.io ping base, for example https://hc-ping.com/<ping-key>. Checks are auto-created by slug
# (radar-<job> and radar-<job>-quality). Without it, no ping is sent and `npm run job` warns.
HEALTHCHECKS_PING_BASE=

# Set to 1 in production units: `npm run job` then refuses to run without HEALTHCHECKS_PING_BASE.
RADAR_REQUIRE_HEALTHCHECKS=

# Roblox Charts filters (explore-api sorts). Empty values fall back to these defaults.
ROBLOX_COUNTRY=all
ROBLOX_DEVICE=computer
